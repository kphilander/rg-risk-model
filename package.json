{
  "name": "rg-risk-model",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "White-label player-protection and responsible-gambling risk dashboard. Synthetic data only.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "build:portable": "vite build --config vite.portable.config.ts && node -e \"require('fs').renameSync('dist-portable/index.html','dist-portable/rg-risk-model.html')\""
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.1.1",
