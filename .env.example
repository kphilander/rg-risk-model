# RG Risk Model integration knobs — consumed at the composition root
# (src/core/runtime.ts). Copy to .env.local to point the same UI/engine at a
# different operator, data source, jurisdiction, or write-back target.

# --- Tenant -----------------------------------------------------------------
VITE_TENANT_ID=demo
VITE_OPERATOR_NAME=Demo Operator
# Jurisdiction rule pack: MGA (=platform default) | UKGC | ON
VITE_JURISDICTION=MGA
VITE_CURRENCY=EUR

# --- Data source (where feature windows come from) --------------------------
# synthetic (default, in-browser) | rest (pull from an ingestion service)
VITE_DATA_SOURCE=synthetic
# Required when VITE_DATA_SOURCE=rest
# VITE_API_BASE_URL=https://ingestion.example.com

# --- Write-back (actions back into the operator system) ---------------------
# When set, logged interventions are POSTed here in addition to the console sink.
# VITE_WEBHOOK_URL=https://operator.example.com/rg-risk/webhooks
